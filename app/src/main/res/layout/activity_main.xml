<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===================================================== -->
        <!-- HEADER / GATEWAY CONFIGURATION                        -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- TITLE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS Gateway"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- ================================================= -->
                <!-- LOCAL API SERVER                                  -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/serverStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Server Status: Stopped"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/serverToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable API Server"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/apiKeyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API Key: Loading..."
                    android:textSize="14sp"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/portText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Port: 8080"
                    android:textSize="14sp"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/apiUrlsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API URLs: Loading..."
                    android:textSize="12sp"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/testApiButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Test API"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/externalDomainButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Setup External Domain"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- CLOUD SMS GATEWAY                                 -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="☁️ Cloud SMS Gateway"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/cloudGatewayStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cloud Status: Disabled"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/cloudGatewayUrlText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gateway: Not configured"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:padding="6dp"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/cloudGatewayToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enable Cloud Gateway"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/cloudGatewaySettingsButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cloud Gateway Settings"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===================================================== -->
        <!-- SMS HISTORY                                           -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS History"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    android:background="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/smsHistoryRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="8dp"
                    tools:listitem="@layout/item_sms_history" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- SEND SMS FAB                                               -->
    <!-- ========================================================= -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/sendSmsFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_dialog_email"
        app:tint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>